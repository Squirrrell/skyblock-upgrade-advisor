{
  "name": "skyblock-upgrade-advisor",
  "version": "0.1.0",
  "private": true,
  "description": "Look up a Hypixel SkyBlock profile and see every farming fortune, hunting fortune and consumable upgrade you are missing, priced from the bazaar and auction house.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "build:pages": "vite build && node scripts/build-data.mjs dist/data",
    "preview:pages": "vite preview --port 4173",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test"
  },
  "dependencies": {
    "express": "^5.3.0",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5"
  }
}
